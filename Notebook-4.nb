Cell[BoxData[
 RowBox[{
  RowBox[{"qfinal", "[", 
   RowBox[{"\[Gamma]_", ",", "t_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"qsol", "[", "t", "]"}], "/.", 
   RowBox[{"bcsol", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.947544524541604*^9, 3.947544565809607*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"6f61164c-2eb8-4871-946b-084b5c10c5b3"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "t"}], "/", "2"}]], " ", 
   SqrtBox["\[Gamma]"], " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "t", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"4", " ", "\[Gamma]"}]}]]}], "-", 
     RowBox[{"ArcCos", "[", 
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"4", " ", "\[Gamma]"}]}]], 
       RowBox[{"2", " ", 
        SqrtBox["\[Gamma]"]}]], "]"}]}], "]"}]}], 
  SqrtBox[
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"4", " ", "\[Gamma]"}]}]]]], "Output",
 CellChangeTimes->{{3.9475445394086943`*^9, 3.9475445683975267`*^9}, 
   3.9475639988223057`*^9, 3.947639251983336*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"af7b39f5-46ec-4b40-a075-db4e81815b3a"]
}, Open  ]],

