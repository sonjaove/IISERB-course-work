Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"x", "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}]}]}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.947114495684849*^9, 3.947114528103793*^9}, {
  3.947114719942067*^9, 3.947114730291047*^9}},
 CellLabel->
  "In[617]:=",ExpressionUUID->"243a287b-b4b7-4784-8e91-d4b9884f5c9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "2"}]], " ", 
      TemplateBox[{"2"},
       "C"], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "2"}]], " ", 
      TemplateBox[{"1"},
       "C"], " ", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}]}], "}"}], "}"}]], "Output",\

 CellChangeTimes->{3.947114529572702*^9, 3.947114732784466*^9},
 CellLabel->
  "Out[617]=",ExpressionUUID->"458a46c6-9458-4e6c-9ffe-45fdb5e92c6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "''"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x", "[", "t", "]"}]}], "-", 
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.947545633212839*^9, 3.947545665077352*^9}},
 CellLabel->
  "In[781]:=",ExpressionUUID->"7a1bf705-7d82-4bb3-8dcf-f64355731930"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "t"}], "/", "2"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.947545667378344*^9},
 CellLabel->
  "Out[781]=",ExpressionUUID->"959bc64f-e266-47ce-85cd-f0da62dcf5d9"]
}, Open  ]],

