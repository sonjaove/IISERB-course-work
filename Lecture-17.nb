Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], "x"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ti", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tf", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmax", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"(", 
      RowBox[{"tf", "-", "ti"}], ")"}], "nmax"], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xprev", "=", "xi"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tprev", "=", "ti"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"Append", "[", 
    RowBox[{"datalist", ",", 
     RowBox[{"{", 
      RowBox[{"tprev", ",", "xprev"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "<=", "nmax"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{
    RowBox[{"tnext", "=", 
     RowBox[{"tprev", "+", "h"}]}], ";", "\[IndentingNewLine]", "      ", 
    RowBox[{"xnext", "=", 
     RowBox[{"xprev", "+", " ", 
      RowBox[{"h", "  ", 
       RowBox[{"f", "[", 
        RowBox[{"tprev", ",", "xprev"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"datalist", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist", ",", 
       RowBox[{"{", 
        RowBox[{"tnext", ",", "xnext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"xprev", "=", "xnext"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"tprev", "=", "tnext"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{3.948330505507072*^9, 3.948331422003186*^9},
 CellLabel->
  "In[1936]:=",ExpressionUUID->"af4284ec-11e3-4fcc-bced-8ff506f4d267"],

