Cell[BoxData[
 RowBox[{
  RowBox[{"sadlist", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"alist", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Nmat"}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"data", " ", "list", " ", "for", " ", "a"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"blist", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Nmat"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"data", " ", "list", " ", "for", " ", "b"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"clist", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Nmat"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"data", " ", "list", " ", "for", " ", "c"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dlist", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Nmat"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"data", " ", "list", " ", "for", " ", "d"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"deltalist", " ", "=", " ", 
       RowBox[{
        RowBox[{"alist", " ", "dlist"}], " ", "-", " ", 
        RowBox[{"blist", " ", "clist"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fracsaddle", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"1", "-", 
           RowBox[{"UnitStep", "[", "deltalist", "]"}]}], "]"}], "/", 
         RowBox[{"Length", "[", "deltalist", "]"}]}], "//", "N"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"if", " ", "deltalist"}], "<", 
        RowBox[{"0", " ", "it", " ", "is", " ", "a", " ", "saddle"}]}], 
       "*)"}], 
      RowBox[{"{", 
       RowBox[{"Nmat", ",", "fracsaddle"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"Nmat", ",", " ", "1", ",", "100", ",", "1"}], "}"}]}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.95376414783836*^9, 3.953764295443183*^9}, {
  3.953764333701606*^9, 3.953764604458208*^9}},
 CellLabel->
  "In[874]:=",ExpressionUUID->"dff35265-e02e-4e23-b8c0-7a079c7acedd"],

