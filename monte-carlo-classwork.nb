Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"datamonpi", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "=", 
      SuperscriptBox["2", "k"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             FractionBox["4", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"RandomReal", "[", "]"}], "2"], "+", "1"}], ")"}]], 
             ",", 
             RowBox[{"{", "n", "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", "1000", "}"}]}], "]"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "5", ",", "10"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.952991068113505*^9, 3.952991083407292*^9}},
