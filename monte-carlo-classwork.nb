Cell["\<\
------------------------Using a different probability distribution for \
importance sampling for Pi estimation--------------\
\>", "Text",
 CellChangeTimes->{{3.9536792041962748`*^9, 3.953679224706094*^9}, {
  3.953775535557494*^9, 
  3.9537755515914593`*^9}},ExpressionUUID->"d2e07539-39ee-4903-aaf8-\
2feaba153261"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     SuperscriptBox["x", "2"]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.953677429760685*^9, 3.9536774590050497`*^9}, {
  3.953678054557186*^9, 3.953678107140479*^9}},
 CellLabel->
  "In[821]:=",ExpressionUUID->"a68fe056-7280-4895-b9d0-20bba140c76a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", 
  SqrtBox["\[Pi]"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"Erfc", "[", "1", "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.953677433447301*^9, 3.953677464800951*^9}, 
   3.953677880308284*^9, {3.953678068721813*^9, 3.9536781090935297`*^9}},
 CellLabel->
  "Out[821]=",ExpressionUUID->"f5fc05fd-0938-420c-87e9-5c0c58eef7a9"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"p1", "[", "x_", "]"}], ":=", 
  FractionBox[
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     SuperscriptBox["x", "2"]}], "]"}], 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", 
    SqrtBox["\[Pi]"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"Erfc", "[", "1", "]"}]}], ")"}]}]]}]], "Input",
 CellChangeTimes->{{3.953677478710141*^9, 3.953677491994445*^9}, {
  3.953678126448215*^9, 3.953678129525931*^9}},
 CellLabel->
  "In[822]:=",ExpressionUUID->"fc580edc-6736-40dc-89e2-30b75d4920e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dist1", "=", 
   RowBox[{"ProbabilityDistribution", "[", 
    RowBox[{
     RowBox[{"p1", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.953677522567911*^9, 3.953677524275518*^9}},
 CellLabel->
  "In[823]:=",ExpressionUUID->"f3e4e003-9e0f-4727-80e5-1db256808f50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{"Dist1", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.953677529790434*^9, 3.953677628083811*^9}},
